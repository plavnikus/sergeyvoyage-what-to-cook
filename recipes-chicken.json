ое филе","qty":500,"unit":"г","optional":false,"note":""},{"block":"Панировка","name":"Панко","qty":60,"unit":"г","optional":false,"note":""},{"block":"Панировка","name":"Мука","qty":30,"unit":"г","optional":false,"note":""},{"block":"Панировка","name":"Яйцо","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Панировка","name":"Паприка","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Панировка","name":"Сушёный чеснок","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Глазурь","name":"Мёд","qty":50,"unit":"г","optional":false,"note":""},{"block":"Глазурь","name":"Сливочное масло","qty":30,"unit":"г","optional":false,"note":""},{"block":"Глазурь","name":"Чили","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Основа","name":"Соль","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Нарежьте курицу стрипсами, приправьте и обваляйте в муке, яйце и панировке.","Готовьте в аэрогриле при 200 °C 9–11 минут до румяной корочки.","Растопите сливочное масло с мёдом и при желании добавьте чили.","Покройте готовые стрипсы горячей глазурью непосредственно перед подачей."]},{"id":"C03","active":true,"group":"Курица","subgroup":"паста","title":"Сливочная паста с курицей и вялеными томатами, ради которой стоит достать сковороду","internal":"Сливочная паста с курицей и вялеными томатами","servings":4,"time":25,"active_time":20,"satiety":"сытный","method":"сковорода + кастрюля","one_dish":false,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Куриное филе","qty":450,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Паста","qty":320,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Сливки 20%","qty":250,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Куриный бульон","qty":150,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Пармезан","qty":70,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Вяленые томаты","qty":60,"unit":"г","optional":