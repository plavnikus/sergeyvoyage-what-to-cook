[{"id":"M01","active":true,"group":"Мясо / фарш","subgroup":"свиной или смешанный фарш","title":"Фарш с хрустящей капустой за 15 минут, когда сил готовить уже нет","internal":"Азиатская капуста с фаршем","servings":4,"time":15,"active_time":15,"satiety":"универсальный","method":"сковорода","one_dish":true,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Свиной или смешанный фарш","qty":500,"unit":"г","optional":false,"note":""},{"block":"Овощи","name":"Белокочанная капуста","qty":450,"unit":"г","optional":false,"note":""},{"block":"Овощи","name":"Морковь","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":3,"unit":"зубчика","optional":false,"note":""},{"block":"Соус","name":"Имбирь","qty":15,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Соевый соус","qty":50,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Рисовый или яблочный уксус","qty":15,"unit":"мл","optional":false,"note":""},{"block":"Финиш","name":"Кунжутное масло","qty":5,"unit":"мл","optional":false,"note":""},{"block":"Финиш","name":"Зелёный лук","qty":3,"unit":"пера","optional":false,"note":""},{"block":"Финиш","name":"Чили","qty":null,"unit":"по вкусу","optional":true,"note":""}],"steps":["На сильном огне хорошо подрумяньте фарш.","Добавьте чеснок и имбирь, затем тонко нашинкованную капусту и морковь.","Влейте соевый соус и уксус и готовьте несколько минут, чтобы овощи размягчились, но сохранили хруст.","Снимите с огня, добавьте кунжутное масло и зелёный лук."]},{"id":"M02","active":true,"group":"Мясо / фарш","subgroup":"говяжий фарш","title":"Корейский боул с говядиной, который превращает обычный фарш в отличный ужин","internal":"Рисовый боул с говяжьим фаршем в корейском стиле","servings":4,"time":30,"active_time":15,"satiety":"сытный","method":"сковорода + рис","one_dish":false,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Говяжий фарш","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Рис сухой","qty":250,"unit":"г","optional":false,"note":"Для быстрого варианта 500–600 г готового риса"},{"block":"Соус","name":"Соевый соус","qty":60,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Мёд или коричневый сахар","qty":30,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":3,"unit":"зубчика","optional":false,"note":""},{"block":"Соус","name":"Имбирь","qty":15,"unit":"г","optional":false,"note":""},{"block":"Финиш","name":"Кунжутное масло","qty":5,"unit":"мл","optional":false,"note":""},{"block":"Финиш","name":"Огурец","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Финиш","name":"Зелёный лук","qty":3,"unit":"пера","optional":false,"note":""},{"block":"Финиш","name":"Кунжут","qty":10,"unit":"г","optional":true,"note":""},{"block":"Финиш","name":"Острый соус","qty":null,"unit":"по вкусу","optional":true,"note":""}],"steps":["Если готовите с нуля, поставьте рис вариться.","Хорошо подрумяньте фарш, добавьте чеснок и имбирь.","Влейте соевый соус с мёдом и готовьте, пока мясо не покроется блестящим соусом.","Подайте с рисом, огурцом, зелёным луком и кунжутом."]},{"id":"M03","active":true,"group":"Мясо / фарш","subgroup":"стейк","title":"Сочный стейк-ужин за 15 минут, ради которого не нужна гора посуды","internal":"Стейк с быстрым гарниром на одной сковороде","servings":2,"time":15,"active_time":15,"satiety":"сытный","method":"сковорода","one_dish":true,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Говяжий стейк","qty":450,"unit":"г","optional":false,"note":""},{"block":"Гарнир","name":"Мелкий или заранее отваренный картофель","qty":300,"unit":"г","optional":false,"note":"Можно заменить только фасолью"},{"block":"Гарнир","name":"Стручковая фасоль","qty":200,"unit":"г","optional":false,"note":""},{"block":"Финиш","name":"Сливочное масло","qty":25,"unit":"г","optional":false,"note":""},{"block":"Финиш","name":"Чеснок","qty":2,"unit":"зубчика","optional":false,"note":""},{"block":"Основа","name":"Растительное масло","qty":15,"unit":"мл","optional":false,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Финиш","name":"Зелень","qty":null,"unit":"по вкусу","optional":true,"note":""}],"steps":["Сильно разогрейте сковороду и обжарьте стейк до желаемой степени готовности; дайте отдохнуть.","В той же сковороде подрумяньте картофель и стручковую фасоль.","Добавьте сливочное масло и чеснок.","Нарежьте мясо поперёк волокон и верните к гарниру перед подачей."]},{"id":"M04","active":true,"group":"Мясо / фарш","subgroup":"говяжий фарш","title":"Хрустящие тако-бургеры с сочным мясом и сыром: два любимых блюда стали одним","internal":"Тако-бургеры с говяжьим фаршем","servings":4,"time":20,"active_time":20,"satiety":"сытный","method":"сковорода","one_dish":true,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Говяжий фарш","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Небольшие тортильи","qty":6,"unit":"шт","optional":false,"note":""},{"block":"Начинка","name":"Сыр","qty":150,"unit":"г","optional":false,"note":""},{"block":"Начинка","name":"Листовой салат","qty":100,"unit":"г","optional":false,"note":""},{"block":"Начинка","name":"Маринованные огурцы","qty":100,"unit":"г","optional":false,"note":""},{"block":"Начинка","name":"Лук","qty":0.5,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Майонез","qty":100,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Кетчуп","qty":40,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Горчица","qty":5,"unit":"г","optional":false,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Разделите фарш на порции и подготовьте начинку и соус.","Положите фарш на очень горячую сковороду, сверху тортилью и сильно прижмите.","Когда мясо подрумянится, переверните, добавьте сыр и дайте ему расплавиться.","Дополните соу