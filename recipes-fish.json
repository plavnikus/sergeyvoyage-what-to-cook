[{"id":"F01","active":true,"group":"Рыба / морепродукты","subgroup":"белая рыба","title":"Нежная белая рыба за 15 минут с соусом, который хочется собрать хлебом","internal":"Белая рыба в лимонно-чесночном сливочном соусе","servings":4,"time":15,"active_time":15,"satiety":"полегче","method":"сковорода","one_dish":true,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Филе трески, минтая или хека","qty":600,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Мука","qty":35,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Растительное масло","qty":15,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Сливочное масло","qty":70,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":3,"unit":"зубчика","optional":false,"note":""},{"block":"Соус","name":"Овощной или рыбный бульон","qty":100,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Лимон","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Финиш","name":"Петрушка","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Рыбу обсушите, приправьте и слегка покройте мукой.","Подрумяньте на смеси растительного и части сливочного масла и временно уберите.","Прогрейте чеснок, добавьте бульон и оставшееся сливочное масло.","Верните рыбу, полейте соусом и завершите лимонным соком и зеленью."]},{"id":"F02","active":true,"group":"Рыба / морепродукты","subgroup":"лосось","title":"Лосось с румяной горчичной корочкой: почти всё за вас сделает аэрогриль","internal":"Лосось с дижонской горчицей в аэрогриле","servings":2,"time":25,"active_time":10,"satiety":"полегче","method":"аэрогриль","one_dish":false,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Филе лосося или форели","qty":500,"unit":"г","optional":false,"note":""},{"block":"Покрытие","name":"Дижонская горчица","qty":30,"unit":"г","optional":false,"note":""},{"block":"Приправы","name":"Паприка","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Приправы","name":"Сушёный чеснок","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Финиш","name":"Лимон","qty":0.5,"unit":"шт","optional":false,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Рыбу хорошо обсушите.","Тонко покройте горчицей и добавьте специи.","Готовьте в аэрогриле при 200 °C 12–15 минут в зависимости от толщины.","Перед подачей добавьте лимон."]},{"id":"F03","active":true,"group":"Рыба / морепродукты","subgroup":"лосось + рис","title":"Боул с лососем и рисом, который сделал вчерашний ужин вирусным","internal":"Рисовый боул с лососем и острым сливочным соусом","servings":2,"time":30,"active_time":10,"satiety":"универсальный","method":"сборка + разогрев","one_dish":false,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Лосось","qty":250,"unit":"г","optional":false,"note":"Для быстрого варианта уже приготовленный"},{"block":"Основа","name":"Рис сухой","qty":120,"unit":"г","optional":false,"note":"Для быстрого варианта 300 г готового"},{"block":"Сборка","name":"Авокадо","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Майонез","qty":30,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Острый соус","qty":10,"unit":"г","optional":true,"note":""},{"block":"Соус","name":"Соевый соус","qty":20,"unit":"мл","optional":false,"note":""},{"block":"Сборка","name":"Нори","qty":2,"unit":"листа","optional":false,"note":""},{"block":"Сборка","name":"Огурец","qty":0.5,"unit":"шт","optional":true,"note":""},{"block":"Сборка","name":"Кимчи","qty":null,"unit":"по вкусу","optional":true,"note":""}],"steps":["Если готовите с нуля, приготовьте рис и лосось.","Готовый лосось разберите вилкой и прогрейте вместе с рисом.","Добавьте соевый соус, майонез и острый соус.","Дополните авокадо, огурцом и нори."]},{"id":"F04","active":true,"group":"Рыба / морепродукты","subgroup":"лосось кусочками","title":"Сочные кусочки лосося в медово-острой глазури, которые исчезают прямо из корзины аэрогриля","internal":"Кусочки лосося в медово-остром соусе","servings":3,"time":20,"active_time":12,"satiety":"универсальный","method":"аэрогриль","one_dish":false,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Лосось без кожи","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Растительное масло","qty":5,"unit":"мл","optional":false,"note":""},{"block":"Глазурь","name":"Мёд","qty":40,"unit":"г","optional":false,"note":""},{"block":"Глазурь","name":"Острый соус","qty":30,"unit":"г","optional":false,"note":"Количество можно уменьшить"},{"block":"Глазурь","name":"Чеснок","qty":2,"unit":"зубчика","optional":false,"note":""},{"block":"Глазурь","name":"Соевый соус","qty":5,"unit":"мл","optional":false,"note":""},{"block":"Глазурь","name":"Лайм","qty":0.5,"unit":"шт","optional":false,"note":""},{"block":"Приправы","name":"Паприка и сушёный чеснок","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Нарежьте лосось крупными кубиками, смешайте со специями и маслом.","Готовьте в аэрогриле около 6 минут.","Смешайте компоненты глазури.","Покройте лосось глазурью и верните в аэрогриль ещё на 1–2 минуты."]},{"id":"F05","active":true,"group":"Рыба / морепродукты","subgroup":"креветки","title":"Креветки в чесночно-лимонном масле за 10 минут: аромат собирает всех на кухне","internal":"Жареные креветки с чесноком, лимоном и сливочным маслом","servings":4,"time":10,"active_time":10,"satiety":"полегче","method":"сковорода","one_dish":true,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Очищенные креветки","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Сливочное масло","qty":35,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Растительное масло","qty":15,"unit":"мл","optional":false,"note":""},{"block":"Финиш","name":"Чеснок","qty":4,"unit":"зубчика","optional":false,"note":""},{"block":"Финиш","name":"Лимон","qty":0.5,"unit":"шт","optional":false,"note":""},{"block":"Приправы","name":"Паприка","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Финиш","name":"Петрушка","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Креветки хорошо обсушите.","На очень горячей сковороде обжарьте примерно по 1–2 минуты с каждой стороны.","Добавьте сливочное масло и чеснок и перемешайте ещё около минуты.","Снимите с огня, добавьте лимонный сок и зелень."]},{"id":"F06","active":true,"group":"Рыба / морепродукты","subgroup":"креветки + тако","title":"Хрустящие тако с креветками и лаймовым соусом, на которых сложно остановиться","internal":"Тако с пряными креветками и капустным салатом","servings":4,"time":25,"active_time":20,"satiety":"сытный","method":"сковорода","one_dish":true,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Очищенные креветки","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Небольшие тортильи","qty":8,"unit":"шт","optional":false,"note":""},{"block":"Салат","name":"Капуста","qty":250,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Сметана или густой йогурт","qty":150,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Лайм","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":2,"unit":"зубчика","optional":false,"note":""},{"block":"Приправы","name":"Паприка и кумин","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Соус","name":"Зелень","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Соус","name":"Чили","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Основа","name":"Соль и масло","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Креветки смешайте со специями и быстро обжарьте.","Капусту тонко нашинкуйте и смешайте с соком лайма.","Соедините сметану, лайм, зелень и чеснок.","Прогрейте тортильи, наполните капустой и креветками и добавьте соус."]},{"id":"F07","active":true,"group":"Рыба / морепродукты","subgroup":"креветки + рис","title":"Яркий боул с креветками: 25 минут, а выглядит как ужин из хорошего кафе","internal":"Рисовый боул с креветками, кукурузой и фасолью","servings":4,"time":35,"active_time":20,"satiety":"сытный","method":"сковорода + сборка","one_dish":false,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Очищенные креветки","qty":500,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Рис сухой","qty":250,"unit":"г","optional":false,"note":"Для быстрого варианта 500 г готового"},{"block":"Овощи","name":"Кукуруза","qty":150,"unit":"г","optional":false,"note":""},{"block":"Овощи","name":"Консервированная фасоль","qty":200,"unit":"г","optional":false,"note":""},{"block":"Овощи","name":"Помидоры","qty":2,"unit":"шт","optional":false,"note":""},{"block":"Овощи","name":"Красный лук","qty":0.5,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Сметана или йогурт","qty":150,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Лайм","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":2,"unit":"зубчика","optional":false,"note":""},{"block":"Приправы","name":"Паприка и кумин","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Финиш","name":"Зелень","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Если готовите с нуля, поставьте рис вариться.","Креветки быстро обжарьте со специями.","Смешайте кукурузу, фасоль, помидоры, лук, зелень и часть лайма.","Соберите рис, овощную смесь и горячие креветки и завершите лаймовым соусом."]},{"id":"F08","active":true,"group":"Рыба / морепродукты","subgroup":"креветки + паста","title":"Паста с сочными креветками и чесночным маслом, ради которой достаточно 20 минут","internal":"Паста с креветками, чесноком и лимоном","servings":4,"time":20,"active_time":18,"satiety":"сытный","method":"сковорода + кастрюля","one_dish":false,"few_ingredients":false,"ingredients":[{"block":"Основа","name":"Спагетти или лингвини","qty":350,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Очищенные креветки","qty":450,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Сливочное масло","qty":40,"unit":"г","optional":false,"note":""},{"block":"Соус","name":"Оливковое масло","qty":15,"unit":"мл","optional":false,"note":""},{"block":"Соус","name":"Чеснок","qty":4,"unit":"зубчика","optional":false,"note":""},{"block":"Соус","name":"Лимон","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Финиш","name":"Петрушка","qty":null,"unit":"по вкусу","optional":false,"note":""},{"block":"Финиш","name":"Чили","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Поставьте пасту вариться и сохраните воду от варки.","Креветки быстро подрумяньте и уберите.","Прогрейте чеснок в смеси масел, добавьте немного воды от пасты и лимонный сок.","Верните креветки, добавьте пасту и перемешайте до лёгкой эмульсии.","Завершите зеленью и чили по желанию."]},{"id":"F09","active":true,"group":"Рыба / морепродукты","subgroup":"белая рыба","title":"Белая рыба с пряной корочкой за 15 минут, когда хочется ужин без лишней возни","internal":"Белая рыба, запечённая со специями и лимоном","servings":4,"time":15,"active_time":5,"satiety":"полегче","method":"духовка","one_dish":false,"few_ingredients":true,"ingredients":[{"block":"Основа","name":"Филе минтая, хека или трески","qty":650,"unit":"г","optional":false,"note":""},{"block":"Основа","name":"Растительное или оливковое масло","qty":30,"unit":"мл","optional":false,"note":""},{"block":"Основа","name":"Лимон","qty":1,"unit":"шт","optional":false,"note":""},{"block":"Приправы","name":"Паприка","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Приправы","name":"Сушёный чеснок","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Приправы","name":"Сушёный лук","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Приправы","name":"Тимьян или орегано","qty":1,"unit":"ч. л.","optional":false,"note":""},{"block":"Приправы","name":"Чили","qty":null,"unit":"по вкусу","optional":true,"note":""},{"block":"Приправы","name":"Соль и перец","qty":null,"unit":"по вкусу","optional":false,"note":""}],"steps":["Разогрейте духовку до 200 °C.","Рыбу обсушите, смажьте маслом и покройте смесью специй.","На противень положите ломтики лимона, сверху рыбу.","Запекайте около 10 минут; при необходимости добавьте 1–2 минуты."]}]